# ── LLM (at least one required) ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the model from config/config.json (e.g. gpt-4o-mini, claude-sonnet-5)
AGENT_MODEL=

# ── Slack (required for Slack mode; not needed for CLI mode) ────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_USER_ID=

# ── Optional connectors ─────────────────────────────────────────────────────
# Web search via Tavily (https://tavily.com) — enable in config: connectors.web_search
TAVILY_API_KEY=
# Notion integration token (https://www.notion.so/my-integrations) — connectors.notion
NOTION_API_KEY=
# Gmail + Google Calendar use credentials.json / token.json in the project root.
# Override their locations here if you keep them elsewhere.
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=
# Browser extension auth token — connectors.browser
BROWSER_TOKEN=

# ── Behaviour ───────────────────────────────────────────────────────────────
# Seconds of silence before the agent "sleeps" and runs its pre-exit flow
AGENT_TIMEOUT=300
